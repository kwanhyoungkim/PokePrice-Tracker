# 이 파일을 복사해서 .env 로 저장하고 실제 값을 채워 넣으세요.
# .env 자체는 .gitignore에 있어서 git에는 올라가지 않습니다.

# eBay API (기존)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# 카드 데이터 DB (docker-compose.yml 의 cards-db 서비스)
# docker-compose.yml 기본값과 동일하게 맞춰두면 별도 설정 없이 바로 연결됩니다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pokeprice
POSTGRES_USER=pokeprice
POSTGRES_PASSWORD=pokeprice
